<% layout("/layouts/auth-boilerplate") %>

  <div class="auth-bg">
    <div class="auth-card-glass">
      <div class="auth-header">
        <div class="auth-icon-circle">
          <i class="fa-solid fa-compass"></i>
        </div>
        <h1>Join Wanderlust Loop</h1>
        <p class="text-secondary">Start your adventure today</p>
      </div>

      <!-- Flash Messages -->
      <% if(typeof success !=='undefined' && success.length> 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"
          style="border-radius: var(--radius-md);">
          <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        <% } %>
          <% if(typeof error !=='undefined' && error.length> 0) { %>
            <div class="alert alert-error-glass alert-dismissible fade show" role="alert">
              <i class="fa-solid fa-circle-exclamation me-2"></i>
              <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <% } %>

              <form action="/signup" method="POST" class="needs-validation mt-4" novalidate>
                <div class="form-floating mb-3">
                  <input type="text" class="form-control" id="username" name="username" placeholder="Username" required
                    autocomplete="username" pattern="[a-zA-Z0-9_]{3,20}">
                  <label for="username">
                    <i class="fa-solid fa-user me-2"></i>Username
                  </label>
                  <div class="valid-feedback">Looks good!</div>
                  <div class="invalid-feedback">
                    Username must be 3-20 characters and contain only letters, numbers, or underscores.
                  </div>
                </div>

                <div class="form-floating mb-3">
                  <input type="email" class="form-control" id="email" name="email" placeholder="Email" required
                    autocomplete="email">
                  <label for="email">
                    <i class="fa-solid fa-envelope me-2"></i>Email Address
                  </label>
                  <div class="valid-feedback">Looks good!</div>
                  <div class="invalid-feedback">Please enter a valid email address.</div>
                </div>

                <div class="form-floating mb-3">
                  <input type="password" class="form-control" id="password" name="password" placeholder="Password"
                    required autocomplete="new-password" minlength="6">
                  <label for="password">
                    <i class="fa-solid fa-lock me-2"></i>Password
                  </label>
                  <div class="password-strength mt-2">
                    <div class="progress" style="height: 4px;">
                      <div class="progress-bar" id="strengthBar" role="progressbar" style="width: 0%;" aria-valuenow="0"
                        aria-valuemax="100"></div>
                    </div>
                  </div>
                  <div class="valid-feedback">Looks good!</div>
                  <div class="invalid-feedback">Password must be at least 6 characters long.</div>
                </div>

                <button type="submit" class="btn btn-premium w-100 mt-3">
                  <i class="fa-solid fa-user-plus me-2"></i>Create Account
                </button>
              </form>

              <div class="terms-text text-center mt-3 text-secondary small">
                By signing up, you agree to our
                <a href="#" class="text-decoration-none" style="color: var(--secondary-aqua);">Terms of Service</a>
                and
                <a href="#" class="text-decoration-none" style="color: var(--secondary-aqua);">Privacy Policy</a>
              </div>

              <div class="auth-footer text-center mt-4">
                <p class="text-secondary mb-2">Already have an account?</p>
                <a href="/login" class="text-decoration-none fw-bold" style="color: var(--secondary-aqua);">
                  <i class="fa-solid fa-sign-in-alt me-1"></i>Login Here
                </a>
              </div>
    </div>
  </div>

  <script>
    // Form validation
    (function () {
      'use strict';
      const forms = document.querySelectorAll('.needs-validation');
      Array.from(forms).forEach(form => {
        form.addEventListener('submit', event => {
          if (!form.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
          }
          form.classList.add('was-validated');
        }, false);
      });
    })();

    // Password strength indicator
    const passwordInput = document.getElementById('password');
    const strengthBar = document.getElementById('strengthBar');

    passwordInput.addEventListener('input', function () {
      const password = this.value;
      let strength = 0;

      if (password.length >= 6) strength += 33;
      if (password.length >= 8) strength += 33;
      if (/[A-Z]/.test(password) && /[a-z]/.test(password)) strength += 11;
      if (/[0-9]/.test(password)) strength += 11;
      if (/[^A-Za-z0-9]/.test(password)) strength += 12;

      strength = Math.min(100, strength);
      strengthBar.style.width = strength + '%';

      if (strength < 40) {
        strengthBar.className = 'progress-bar bg-danger';
      } else if (strength < 70) {
        strengthBar.className = 'progress-bar bg-warning';
      } else {
        strengthBar.className = 'progress-bar bg-success';
      }
    });
  </script>