<% layout('layouts/boilerplate') %>

  <style>
    /* Local Scoped Styles for Listings Page */

    .listing-container {
      animation: fadeInUp 0.5s ease-out;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Header */
    /* Header Section */
    /* .listing-header removed in favor of shared content-panel */

    /* Listing Cards */
    .listing-card {
      background: white;
      border-radius: 24px;
      border: 1px solid rgba(0, 0, 0, 0.04);
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
      transition: all 0.3s ease;
      height: 100%;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      position: relative;
      cursor: pointer;
      text-decoration: none;
      color: inherit;
    }

    .listing-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
      border-color: rgba(45, 212, 191, 0.3);
    }

    .card-body {
      padding: 1.5rem;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .card-title {
      font-weight: 700;
      font-size: 1.25rem;
      color: var(--text-main);
      margin-bottom: 0.5rem;
      line-height: 1.4;
    }

    .status-badge {
      background: #ECFDF5;
      color: #059669;
      padding: 0.3rem 0.8rem;
      border-radius: 20px;
      font-weight: 700;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      height: fit-content;
    }

    .creator-info {
      font-size: 0.9rem;
      color: #6B7280;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .info-row {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
      font-size: 0.95rem;
      color: #374151;
    }

    .info-row i {
      width: 20px;
      text-align: center;
      color: var(--primary-teal);
    }

    .bio-text {
      color: #6B7280;
      font-size: 0.9rem;
      line-height: 1.6;
      margin-bottom: 1.5rem;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .interest-badge {
      background: #F3F4F6;
      color: #4B5563;
      padding: 0.35rem 0.8rem;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 600;
      margin-right: 0.4rem;
      margin-bottom: 0.4rem;
      display: inline-block;
    }

    .looking-for {
      font-size: 0.85rem;
      font-weight: 600;
      color: #4B5563;
      background: #FFFBEB;
      padding: 0.5rem 1rem;
      border-radius: 12px;
      width: 100%;
      margin-bottom: 1rem;
    }

    .btn-create {
      background: linear-gradient(135deg, #2DD4BF 0%, #0D9488 100%);
      border: none;
      color: white;
      padding: 0.8rem 1.5rem;
      border-radius: 12px;
      font-weight: 600;
      transition: all 0.3s ease;
      box-shadow: 0 4px 12px rgba(45, 212, 191, 0.3);
      text-decoration: none;
    }

    .btn-create:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 16px rgba(45, 212, 191, 0.4);
      color: white;
    }

    .btn-view-details {
      margin-top: auto;
      background: white;
      border: 1px solid #E5E7EB;
      color: var(--text-main);
      width: 100%;
      padding: 0.7rem;
      border-radius: 12px;
      font-weight: 600;
      text-align: center;
      transition: all 0.2s;
      text-decoration: none;
    }

    .btn-view-details:hover {
      background: #F9FAFB;
      border-color: var(--primary-teal);
      color: var(--primary-teal);
    }

    .empty-state {
      text-align: center;
      padding: 4rem 2rem;
      background: white;
      border-radius: 24px;
      box-shadow: var(--shadow-sm);
    }
  </style>

  <div class="container mt-4 listing-container">
    <div class="row mb-5">
      <div class="col-12">
        <div class="content-panel">
          <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
              <h2 class="text-gradient-teal fw-bold m-0" style="font-size: 2.2rem; letter-spacing: -1px;">
                <i class="fa-solid fa-map-location-dot me-3 text-secondary"></i>Travel Buddy Listings
              </h2>
              <p class="text-muted mb-0 mt-2 ms-1">Join upcoming trips or create your own adventure.</p>
            </div>
            <a href="/buddy/listings/new" class="btn btn-dark rounded-pill px-4 fw-bold shadow-sm">
              <i class="fa-solid fa-plus me-2"></i>Create Listing
            </a>
          </div>

          <div class="row g-4">
            <% if (listings.length===0) { %>
              <div class="col-12">
                <div class="empty-state">
                  <i class="fa-solid fa-earth-americas fa-4x mb-4" style="color: #E5E7EB;"></i>
                  <h3 class="fw-bold text-dark">No active listings yet</h3>
                  <p class="text-muted mb-4">Be the first to create a travel plan and find a buddy!</p>
                  <a href="/buddy/listings/new" class="btn-create px-5">
                    Create First Listing
                  </a>
                </div>
              </div>
              <% } else { %>
                <% listings.forEach((listing, index)=> { %>
                  <div class="col-lg-4 col-md-6"
                    style="--delay: <%= index * 0.1 %>s; animation: fadeInUp 0.5s ease-out backwards; animation-delay: var(--delay);">
                    <div class="listing-card" onclick="window.location.href='/buddy/listings/<%= listing._id %>'">
                      <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                          <h5 class="card-title">
                            <%= listing.title %>
                          </h5>
                          <span class="status-badge">Active</span>
                        </div>

                        <div class="creator-info">
                          <i class="fa-solid fa-circle-user"></i>
                          <span>
                            <%= listing.creator.username %>
                          </span>
                        </div>

                        <div class="info-row">
                          <i class="fa-solid fa-location-dot"></i>
                          <strong>
                            <%= listing.destination %>
                          </strong>
                        </div>

                        <div class="info-row">
                          <i class="fa-solid fa-calendar"></i>
                          <span>
                            <%= new Date(listing.startDate).toLocaleDateString(undefined, { month: 'short' ,
                              day: 'numeric' }) %> -
                              <%= new Date(listing.endDate).toLocaleDateString(undefined, { month: 'short' ,
                                day: 'numeric' , year: 'numeric' }) %>
                          </span>
                        </div>

                        <div class="bio-text mt-3">
                          <%= listing.bio %>
                        </div>

                        <% if (listing.interests && listing.interests.length> 0) { %>
                          <div class="mb-3">
                            <% listing.interests.slice(0, 3).forEach(interest=> { %>
                              <span class="interest-badge">
                                <%= interest %>
                              </span>
                              <% }) %>
                                <% if (listing.interests.length> 3) { %>
                                  <span class="interest-badge" style="background:transparent; color: #9CA3AF;">+<%=
                                      listing.interests.length - 3 %></span>
                                  <% } %>
                          </div>
                          <% } %>

                            <div class="looking-for text-center">
                              <small class="text-uppercase text-muted"
                                style="font-size:0.7rem; display:block; margin-bottom:2px;">Looking For</small>
                              <%= listing.lookingFor.replace('-', ' ' ) %>
                            </div>

                            <a href="/buddy/listings/<%= listing._id %>" class="btn-view-details">
                              View Details
                            </a>
                      </div>
                    </div>
                  </div>
                  <% }) %>
                    <% } %>
          </div> <!-- Close row g-4 -->
        </div> <!-- End content-panel -->
      </div>
    </div>
  </div>