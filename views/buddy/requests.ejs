<% layout('layouts/boilerplate') %>

    <style>
        /* Local Scoped Styles for Requests */
        .requests-container {
            animation: fadeInUp 0.5s ease-out;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Header Section */
        /* .requests-header styles removed - using shared content-panel */

        /* Section Containers */
        .request-section-container {
            background: transparent;
            margin-bottom: 2rem;
        }

        .section-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: #4B5563;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        /* Request Cards */
        .request-card {
            background: white;
            border: 1px solid rgba(0, 0, 0, 0.04);
            border-radius: 20px;
            padding: 1.5rem;
            margin-bottom: 1rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            transition: all 0.2s ease;
            border-left: 4px solid #E5E7EB;
            /* Default border */
        }

        .request-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.1);
        }

        .request-card.received {
            border-left-color: #10B981;
            /* Green for received */
        }

        .request-card.sent {
            border-left-color: #3B82F6;
            /* Blue for sent */
        }

        /* Status Badges */
        .status-badge {
            padding: 0.35rem 0.8rem;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .badge-pending {
            background: #FFF7ED;
            color: #EA580C;
        }

        .badge-accepted {
            background: #ECFDF5;
            color: #059669;
        }

        .badge-rejected {
            background: #FEF2F2;
            color: #DC2626;
        }

        /* Action Buttons */
        .btn-action {
            border: none;
            border-radius: 10px;
            padding: 0.5rem 1.2rem;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }

        .btn-accept {
            background: #10B981;
            color: white;
        }

        .btn-accept:hover {
            background: #059669;
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
        }

        .btn-reject {
            background: #F3F4F6;
            color: #4B5563;
        }

        .btn-reject:hover {
            background: #EF4444;
            color: white;
            transform: translateY(-1px);
        }

        .form-control-sm-custom {
            border-radius: 10px;
            border: 1px solid #E5E7EB;
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
        }

        .empty-state-mini {
            text-align: center;
            padding: 3rem;
            background: white;
            border-radius: 20px;
            border: 2px dashed #E5E7EB;
            color: #9CA3AF;
        }

        /* Admin Table */
        .admin-card {
            border: none;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: var(--shadow-sm);
        }

        .table thead th {
            background: #F9FAFB;
            font-size: 0.85rem;
            text-transform: uppercase;
            color: #6B7280;
            padding: 1rem;
            border-bottom: 2px solid #E5E7EB;
        }

        .table tbody td {
            padding: 1rem;
            vertical-align: middle;
        }
    </style>

    <div class="container mt-4 requests-container">
        <div class="row mb-5">
            <div class="col-12">
                <div class="content-panel">
                    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                        <div>
                            <h2 class="text-gradient-purple fw-bold m-0"
                                style="font-size: 2.2rem; letter-spacing: -1px;">
                                <i class="fa-solid fa-envelope me-3 text-warning"></i>Travel Requests
                            </h2>
                            <p class="text-muted mb-0 mt-2 ms-1">Manage your pending and sent travel buddy connections.
                            </p>
                        </div>
                    </div>

                    <!-- Received Requests -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="request-section-container">
                                <h5 class="section-title"><i class="fa-solid fa-inbox text-success"></i> Received
                                    Requests</h5>

                                <% if (receivedRequests.length===0) { %>
                                    <div class="empty-state-mini">
                                        <i class="fa-solid fa-mug-hot fa-2x mb-2"></i>
                                        <p class="mb-0">No new requests pending.</p>
                                    </div>
                                    <% } else { %>
                                        <% receivedRequests.forEach(request=> { %>
                                            <div class="request-card received">
                                                <div class="row align-items-center">
                                                    <div class="col-md-8 mb-3 mb-md-0">
                                                        <div class="d-flex align-items-start gap-2 mb-2">
                                                            <span class="badge badge-pending">Pending Approval</span>
                                                            <small class="text-muted">
                                                                <%= new Date(request.createdAt).toLocaleDateString() %>
                                                            </small>
                                                        </div>
                                                        <h5 class="mb-1"
                                                            style="font-weight: 700; color:var(--text-main);">
                                                            <%= request.from.username %>
                                                        </h5>
                                                        <% if (request.listing) { %>
                                                            <p class="mb-2 text-muted small">
                                                                Requesting to join: <strong>
                                                                    <%= request.listing.title %>
                                                                </strong>
                                                            </p>
                                                            <% } %>

                                                                <div class="bg-light p-2 rounded mb-0 text-dark small"
                                                                    style="border-left: 3px solid #D1D5DB;">
                                                                    "<%= request.message || 'No message included' %>"
                                                                </div>
                                                    </div>
                                                    <div class="col-md-4 text-md-end">
                                                        <% if (request.status==='pending' ) { %>
                                                            <form method="POST"
                                                                action="/buddy/requests/<%= request._id %>/accept"
                                                                class="d-block mb-2">
                                                                <textarea class="form-control form-control-sm-custom"
                                                                    name="responseMessage" rows="1"
                                                                    placeholder="Reply (optional)"></textarea>
                                                                <div class="d-flex justify-content-md-end gap-2">
                                                                    <button type="submit" class="btn-action btn-accept">
                                                                        <i class="fa-solid fa-check"></i> Accept
                                                                    </button>
                                                                    <button type="submit"
                                                                        formaction="/buddy/requests/<%= request._id %>/reject"
                                                                        class="btn-action btn-reject">
                                                                        <i class="fa-solid fa-xmark"></i> Reject
                                                                    </button>
                                                                </div>
                                                            </form>
                                                            <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                            <% }) %>
                                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Sent Requests -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="request-section-container">
                                <h5 class="section-title"><i class="fa-solid fa-paper-plane text-primary"></i> Sent
                                    Requests</h5>

                                <% if (sentRequests.length===0) { %>
                                    <div class="empty-state-mini">
                                        <p class="mb-0">You haven't sent any requests yet.</p>
                                    </div>
                                    <% } else { %>
                                        <% sentRequests.forEach(request=> { %>
                                            <div class="request-card sent">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <h6 class="mb-1">To: <strong>
                                                                <%= request.to.username %>
                                                            </strong></h6>
                                                        <% if (request.listing) { %>
                                                            <small class="text-muted d-block mb-2">For: <%=
                                                                    request.listing.title %>
                                                            </small>
                                                            <% } %>
                                                                <div class="text-muted small">
                                                                    You: "<%= request.message %>"
                                                                </div>
                                                                <% if (request.responseMessage) { %>
                                                                    <div
                                                                        class="mt-2 text-dark small p-2 bg-light rounded">
                                                                        <strong>Reply:</strong> "<%=
                                                                            request.responseMessage %>"
                                                                    </div>
                                                                    <% } %>
                                                    </div>
                                                    <div class="text-end">
                                                        <span class="status-badge badge-<%= request.status %>">
                                                            <%= request.status %>
                                                        </span>
                                                        <div class="text-muted small mt-1">
                                                            <%= new Date(request.createdAt).toLocaleDateString() %>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <% }) %>
                                                <% } %>
                            </div>
                        </div>
                    </div>

                </div> <!-- End content-panel -->
            </div>
        </div>

        <!-- Admin View -->
        <% if (isAdmin && allRequests) { %>
            <div class="row">
                <div class="col-12">
                    <div class="card admin-card">
                        <div class="card-header bg-white border-bottom">
                            <h6 class="mb-0 fw-bold text-uppercase"><i class="fa-solid fa-shield-halved me-2"></i>Admin
                                Monitor</h6>
                        </div>
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>From</th>
                                        <th>To</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% allRequests.forEach(request=> { %>
                                        <tr>
                                            <td>
                                                <%= request.from.username %>
                                            </td>
                                            <td>
                                                <%= request.to.username %>
                                            </td>
                                            <td>
                                                <span class="status-badge badge-<%= request.status %>">
                                                    <%= request.status %>
                                                </span>
                                            </td>
                                            <td>
                                                <%= new Date(request.createdAt).toLocaleDateString() %>
                                            </td>
                                            <td>
                                                <form method="POST"
                                                    action="/buddy/requests/<%= request._id %>?_method=DELETE"
                                                    class="d-inline">
                                                    <button type="submit" class="btn btn-link text-danger p-0"
                                                        onclick="return confirm('Delete this request?')">
                                                        <i class="fa-solid fa-trash-can"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>
    </div>