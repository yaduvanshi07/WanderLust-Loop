<% layout("/layouts/auth-boilerplate") %>

  <div class="auth-bg">
    <div class="auth-card-glass">
      <div class="auth-header">
        <div class="auth-icon-circle">
          <i class="fa-solid fa-compass"></i>
        </div>
        <h1>Welcome Back</h1>
        <p class="text-secondary">Login to continue your journey</p>
      </div>

      <!-- Flash Messages -->
      <% if(typeof success !=='undefined' && success.length> 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert"
          style="border-radius: var(--radius-md);">
          <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        <% } %>
          <% if(typeof error !=='undefined' && error.length> 0) { %>
            <div class="alert alert-error-glass alert-dismissible fade show" role="alert">
              <i class="fa-solid fa-circle-exclamation me-2"></i>
              <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <% } %>

              <form action="/login" method="POST" class="needs-validation mt-4" novalidate>
                <!-- Username -->
                <div class="form-floating mb-3">
                  <input type="text" class="form-control" id="username" name="username" placeholder="Username" required
                    autocomplete="username">
                  <label for="username">
                    <i class="fa-solid fa-user me-2"></i>Username
                  </label>
                  <div class="valid-feedback">Looks good!</div>
                  <div class="invalid-feedback">Please enter your username.</div>
                </div>

                <!-- Password -->
                <div class="form-floating mb-3">
                  <input type="password" class="form-control" id="password" name="password" placeholder="Password"
                    required autocomplete="current-password">
                  <label for="password">
                    <i class="fa-solid fa-lock me-2"></i>Password
                  </label>
                  <div class="invalid-feedback">Please enter your password.</div>
                </div>

                <!-- Admin Hint Section -->
                <div class="admin-hint-section mb-3 p-3 bg-light rounded-3"
                  style="border-left: 4px solid var(--primary-saffron);">
                  <label for="adminHintVerify" class="form-label fw-bold text-warning">
                    <i class="fa-solid fa-shield-halved me-2"></i>Admin Personal Hint
                  </label>
                  <input type="text" class="form-control" id="adminHintVerify" name="adminHintVerify"
                    placeholder="Enter your admin hint (admins only)" autocomplete="off">
                  <div class="form-text">
                    <i class="fa-solid fa-info-circle me-1"></i>Required only if your account is admin
                  </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-premium w-100 mt-3">
                  <i class="fa-solid fa-sign-in-alt me-2"></i>Login
                </button>
              </form>

              <div class="auth-footer text-center mt-4">
                <p class="text-secondary mb-2">Don't have an account?</p>
                <a href="/signup" class="text-decoration-none fw-bold" style="color: var(--secondary-aqua);">
                  <i class="fa-solid fa-user-plus me-1"></i>Sign Up Now
                </a>
              </div>
    </div>
  </div>

  <script>
    // Form validation
    (function () {
      'use strict';
      const forms = document.querySelectorAll('.needs-validation');
      Array.from(forms).forEach(form => {
        form.addEventListener('submit', event => {
          if (!form.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
          }
          form.classList.add('was-validated');
        }, false);
      });
    })();
  </script>