<% layout("/layouts/boilerplate") %>

    <style>
        .form-container {
            background: white;
            padding: 3rem;
            border-radius: 25px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            margin-top: 2rem;
            margin-bottom: 2rem;
            border: 1px solid rgba(0, 0, 0, 0.05);
        }

        .form-label {
            font-weight: 600;
            color: #4B5563;
        }

        .form-control {
            border-radius: 10px;
            padding: 0.8rem;
            border: 1px solid #E5E7EB;
        }

        .form-control:focus {
            border-color: #2DD4BF;
            /* Teal accent */
            box-shadow: 0 0 0 4px rgba(45, 212, 191, 0.1);
        }

        .add-btn {
            background: #1F2937;
            border: none;
            padding: 0.8rem 2rem;
            border-radius: 25rem;
            font-weight: 600;
            transition: all 0.3s;
        }

        .add-btn:hover {
            background: black;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        }
    </style>

    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="form-container">
                <h3 class="mb-4 fw-bold text-center" style="color: #111827;">Create a New Listing</h3>
                <form method="POST" action="/listings" novalidate class="needs-validation"
                    enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input name="listing[title]" placeholder="Add a catchy title" type="text" class="form-control"
                            required>
                        <div class="valid-feedback"> Title looks good!</div>
                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea name="listing[description]" placeholder="Enter the description" class="form-control"
                            rows="4" required></textarea>
                        <div class="invalid-feedback"> Description must be short </div>
                    </div>

                    <div class="mb-3">
                        <label for="image" class="form-label">Upload Image</label>
                        <input name="listing[image]" type="file" class="form-control" required>
                    </div>

                    <div class="row">
                        <div class="mb-3 col-md-4">
                            <label for="price" class="form-label">Price</label>
                            <input name="listing[price]" placeholder="Example: 1500" class="form-control" required>
                            <div class="invalid-feedback"> Price should be valid</div>
                        </div>

                        <div class="mb-3 col-md-8">
                            <label for="country" class="form-label">Country</label>
                            <input name="listing[country]" placeholder="Example: India" type="text" class="form-control"
                                required>
                            <div class="invalid-feedback">Country name should be valid</div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="location" class="form-label">Location</label>
                        <input name="listing[location]" placeholder="Example: Varanasi" type="text" class="form-control"
                            required>
                        <div class="invalid-feedback">Location should be valid</div>
                    </div>

                    <div class="text-center">
                        <button class="btn btn-dark add-btn w-100">Add Listing</button>
                    </div>
                </form>
            </div>
        </div>
    </div>