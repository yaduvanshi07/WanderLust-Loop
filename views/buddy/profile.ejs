<% layout('layouts/boilerplate') %>

    <style>
        /* Page Specific Styles for Premium Glass UI */
        .glass-panel {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 24px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
            overflow: hidden;
        }

        .form-control,
        .form-select {
            border-radius: 12px;
            border: 1px solid #E5E7EB;
            padding: 0.75rem 1rem;
            transition: all 0.2s;
            background: rgba(249, 250, 251, 0.5);
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--primary-teal);
            box-shadow: 0 0 0 4px rgba(45, 212, 191, 0.1);
            background: white;
        }

        .section-title {
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #9CA3AF;
            font-weight: 700;
            margin-bottom: 1rem;
            margin-top: 1.5rem;
        }

        /* Interest Chips */
        .chip-group {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .chip-input {
            display: none;
        }

        .chip-label {
            display: inline-flex;
            align-items: center;
            padding: 0.5rem 1rem;
            background: white;
            border: 1px solid #E5E7EB;
            border-radius: 50px;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            user-select: none;
            color: var(--text-main);
        }

        .chip-input:checked+.chip-label {
            background: linear-gradient(135deg, #ECFEFF 0%, #CCFBF1 100%);
            border-color: var(--primary-teal);
            color: var(--primary-teal);
            box-shadow: 0 2px 10px rgba(45, 212, 191, 0.15);
            transform: translateY(-1px);
        }

        .chip-label:hover {
            background: #F9FAFB;
            border-color: #D1D5DB;
        }

        .profile-img-container {
            position: relative;
            width: 160px;
            height: 160px;
            margin: 0 auto;
        }

        .img-glow {
            border-radius: 50%;
            box-shadow: 0 0 20px rgba(45, 212, 191, 0.3);
            border: 4px solid white;
        }

        .upload-overlay {
            position: absolute;
            bottom: 5px;
            right: 5px;
            width: 40px;
            height: 40px;
            background: var(--primary-teal);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            border: 3px solid white;
            cursor: pointer;
            transition: transform 0.2s;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

        .upload-overlay:hover {
            transform: scale(1.1);
            background: var(--primary-gold);
        }
    </style>

    <div class="container mt-5 mb-5">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <!-- Header -->
                <div class="text-center mb-5">
                    <h2 class="display-6 fw-bold mb-2">My Travel <span class="text-gradient-teal">Profile</span></h2>
                    <p class="text-muted">Customize how you appear to other travelers and find your perfect buddy.</p>
                </div>

                <div class="glass-panel p-5">
                    <form method="POST" action="/buddy/profile" enctype="multipart/form-data">

                        <!-- Profile Picture Section -->
                        <div class="text-center mb-5">
                            <div class="profile-img-container mb-3">
                                <% if (user.travelBuddyProfile?.profilePicture?.url) { %>
                                    <img src="<%= user.travelBuddyProfile.profilePicture.url %>"
                                        class="img-fluid img-glow w-100 h-100" style="object-fit: cover;"
                                        alt="Profile Picture">
                                    <% } else { %>
                                        <div
                                            class="img-glow w-100 h-100 d-flex align-items-center justify-content-center bg-light">
                                            <i class="fa-regular fa-user fa-4x text-muted"></i>
                                        </div>
                                        <% } %>

                                            <label for="profilePicture" class="upload-overlay">
                                                <i class="fa-solid fa-camera"></i>
                                            </label>
                                            <input type="file" id="profilePicture" name="profilePicture"
                                                accept="image/*" style="display: none;">
                            </div>
                            <h5 class="fw-bold mb-1">
                                <%= user.username %>
                            </h5>
                            <p class="text-muted small mb-0">
                                <%= user.email %>
                            </p>
                        </div>

                        <!-- Main Form Grid -->
                        <div class="row g-4">

                            <!-- Basic Info Section -->
                            <div class="col-12">
                                <div class="section-title"><i class="fa-solid fa-id-card me-2"></i>The Basics</div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="number" class="form-control" id="age" name="age"
                                        value="<%= user.travelBuddyProfile?.age || '' %>" min="18" max="99"
                                        placeholder="Age">
                                    <label for="age">My Age</label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select class="form-select" id="gender" name="gender">
                                        <option value="prefer-not-to-say"
                                            <%=user.travelBuddyProfile?.gender==='prefer-not-to-say' ? 'selected' : ''
                                            %>>Prefer not to say</option>
                                        <option value="male" <%=user.travelBuddyProfile?.gender==='male' ? 'selected'
                                            : '' %>>Male</option>
                                        <option value="female" <%=user.travelBuddyProfile?.gender==='female'
                                            ? 'selected' : '' %>>Female</option>
                                        <option value="non-binary" <%=user.travelBuddyProfile?.gender==='non-binary'
                                            ? 'selected' : '' %>>Non-binary</option>
                                    </select>
                                    <label for="gender">Identify As</label>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea class="form-control" id="bio" name="bio" style="height: 120px"
                                        placeholder="Bio"><%= preference?.bio || '' %></textarea>
                                    <label for="bio">My Bio - Tell us about yourself...</label>
                                </div>
                            </div>

                            <!-- Visibility Toggle -->
                            <div class="col-12">
                                <div class="form-check form-switch p-3 border rounded-3 bg-white">
                                    <input class="form-check-input ms-0 me-3" type="checkbox" role="switch"
                                        name="isActive" value="true" id="isActive" <%=user.travelBuddyProfile?.isActive
                                        ? 'checked' : '' %> style="float: none;">
                                    <label class="form-check-label fw-semibold" for="isActive">
                                        Publicly Visible to Other Travelers
                                    </label>
                                    <div class="small text-muted mt-1 ms-1">Enable this to show up in "Find Matches"
                                        results.</div>
                                </div>
                            </div>

                            <!-- Preferences Section -->
                            <div class="col-12 mt-5">
                                <div class="section-title"><i class="fa-solid fa-sliders me-2"></i>Travel Preferences
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold mb-2">Travel Style</label>
                                <select class="form-select border-0 bg-light py-3" name="travelStyle">
                                    <option value="flexible" <%=preference?.travelStyle==='flexible' ? 'selected' : ''
                                        %>>Flexible - I adapt easily</option>
                                    <option value="budget" <%=preference?.travelStyle==='budget' ? 'selected' : '' %>
                                        >Budget - Saving everywhere</option>
                                    <option value="mid-range" <%=preference?.travelStyle==='mid-range' ? 'selected' : ''
                                        %>>Mid-range - Comfort meets value</option>
                                    <option value="luxury" <%=preference?.travelStyle==='luxury' ? 'selected' : '' %>
                                        >Luxury - Treat myself</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold mb-2">Ideally Looking For</label>
                                <select class="form-select border-0 bg-light py-3" name="lookingFor">
                                    <option value="travel-buddy" <%=preference?.lookingFor==='travel-buddy' ? 'selected'
                                        : '' %>>Travel Buddy (Trip only)</option>
                                    <option value="roommate" <%=preference?.lookingFor==='roommate' ? 'selected' : '' %>
                                        >Roommate (Long term)</option>
                                    <option value="both" <%=preference?.lookingFor==='both' ? 'selected' : '' %>>Both /
                                        Open</option>
                                </select>
                            </div>

                            <!-- Chips Sections -->
                            <div class="col-12 mt-4">
                                <label class="form-label fw-bold mb-3">My Interests</label>
                                <div class="chip-group">
                                    <% const allInterests=['foodie', 'adventure' , 'culture' , 'beach' , 'mountains'
                                        , 'city' , 'nature' , 'nightlife' , 'budget' , 'luxury' , 'backpacking'
                                        , 'wellness' , 'photography' , 'sports' , 'music' , 'art' , 'history'
                                        , 'wildlife' , 'nomad' , 'solo-travel' ]; %>
                                        <% allInterests.forEach(interest=> { %>
                                            <input type="checkbox" class="chip-input" name="interests"
                                                value="<%= interest %>" id="int_<%= interest %>"
                                                <%=preference?.interests?.includes(interest) ? 'checked' : '' %>>
                                            <label class="chip-label" for="int_<%= interest %>">
                                                <% if(interest==='foodie' ) { %><i
                                                        class="fa-solid fa-utensils me-2 text-warning"></i>
                                                    <% } %>
                                                        <% if(interest==='adventure' ) { %><i
                                                                class="fa-solid fa-person-hiking me-2 text-success"></i>
                                                            <% } %>
                                                                <% if(interest==='beach' ) { %><i
                                                                        class="fa-solid fa-umbrella-beach me-2 text-info"></i>
                                                                    <% } %>
                                                                        <% if(interest==='photography' ) { %><i
                                                                                class="fa-solid fa-camera me-2"></i>
                                                                            <% } %>
                                                                                <% if(interest==='nightlife' ) { %><i
                                                                                        class="fa-solid fa-martini-glass me-2 text-primary"></i>
                                                                                    <% } %>
                                                                                        <%= interest.charAt(0).toUpperCase()
                                                                                            +
                                                                                            interest.slice(1).replace(/-/g, ' '
                                                                                            ) %>
                                            </label>
                                            <% }) %>
                                </div>
                            </div>

                            <div class="col-12 mt-4">
                                <label class="form-label fw-bold mb-3">Personality Traits</label>
                                <div class="chip-group">
                                    <% const traits=['introverted', 'extroverted' , 'adventurous' , 'laid-back'
                                        , 'organized' , 'spontaneous' , 'early-riser' , 'night-owl' , 'social'
                                        , 'independent' ]; %>
                                        <% traits.forEach(trait=> { %>
                                            <input type="checkbox" class="chip-input" name="personalityTraits"
                                                value="<%= trait %>" id="trait_<%= trait %>"
                                                <%=preference?.personalityTraits?.includes(trait) ? 'checked' : '' %>>
                                            <label class="chip-label" for="trait_<%= trait %>">
                                                <%= trait.charAt(0).toUpperCase() + trait.slice(1).replace(/-/g, ' ' )
                                                    %>
                                            </label>
                                            <% }) %>
                                </div>
                            </div>

                            <!-- Destination & Budget -->
                            <div class="col-12 mt-4">
                                <label class="form-label fw-bold">Dream Destinations</label>
                                <input type="text" class="form-control" name="preferredDestinations"
                                    value="<%= preference?.preferredDestinations?.join(', ') || '' %>"
                                    placeholder="e.g., Paris, Tokyo, Bali (comma separated)">
                            </div>

                            <label class="form-label fw-bold mt-4">Budget Range (₹)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0">Min</span>
                                <input type="number" class="form-control" name="budgetMin"
                                    value="<%= preference?.budgetRange?.min || 0 %>">
                                <span class="input-group-text bg-white border-start-0 border-end-0">-</span>
                                <span class="input-group-text bg-white border-end-0">Max</span>
                                <input type="number" class="form-control" name="budgetMax"
                                    value="<%= preference?.budgetRange?.max || 50000 %>">
                            </div>

                            <!-- Action Buttons -->
                            <div class="col-12 mt-5 pt-3 border-top">
                                <div class="d-flex justify-content-end gap-3">
                                    <a href="/buddy/matches" class="btn btn-light rounded-pill px-4">Cancel</a>
                                    <button type="submit" class="btn btn-gradient-primary rounded-pill px-5 py-2">
                                        Save Changes
                                    </button>
                                </div>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Live Image Preview
        document.getElementById('profilePicture').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const img = document.querySelector('.img-glow');
                    const container = document.querySelector('.profile-img-container');

                    // If there's already an img tag
                    if (img.tagName === 'IMG') {
                        img.src = e.target.result;
                    } else {
                        // Replace icon div with new img
                        const newImg = document.createElement('img');
                        newImg.src = e.target.result;
                        newImg.className = 'img-fluid img-glow w-100 h-100';
                        newImg.style.objectFit = 'cover';
                        img.parentNode.replaceChild(newImg, img);
                    }
                };
                reader.readAsDataURL(file);
            }
        });

        // Auto-expand bio text area
        const bioText = document.getElementById('bio');
        if (bioText) {
            bioText.addEventListener('input', function () {
                this.style.height = 'auto';
                this.style.height = (this.scrollHeight) + 'px';
            });
        }
    </script>