<% /* Refined Navbar: Larger Brand, Left-aligned Controls, Button Home */ %>

  <nav class="navbar navbar-expand-md sticky-top">
    <div class="container-fluid d-flex align-items-center">
      <!-- Brand (Larger) -->
      <a class="navbar-brand" href="/listings">
        <i class="fa-solid fa-compass me-3"></i>
        <span>Wanderlust</span><span class="brand-text-teal">Loop</span>
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

        <!-- Left Side Controls (Home Button, Add Listing, Search) -->
        <div class="navbar-nav me-auto align-items-center d-flex flex-column flex-md-row gap-3 gap-md-2 mt-3 mt-md-0">

          <!-- Home Button -->
          <a class="btn-nav-pill" href="/listings">
            Home
          </a>

          <!-- Add Listing Button -->
          <a class="btn-nav-pill" href="/listings/new">
            Add Listing
          </a>

          <!-- Search Form -->
          <form action="/listings" method="GET" class="d-flex search-form position-relative ms-0 ms-md-2" role="search">
            <input class="form-control search-input" type="search" placeholder="Search..." aria-label="Search" name="q"
              value="<%= searchQuery %>">
            <button class="btn-search" type="submit"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
          </form>

          <!-- Find Buddy Button - Always Visible -->
          <% if (currUser) { %>
            <!-- Logged-in: Full functionality with dropdown -->
            <div class="nav-item dropdown ms-0 ms-md-2 text-center text-md-start">
              <a class="nav-link dropdown-toggle btn-find-buddy d-block d-md-inline-block" href="#" role="button"
                data-bs-toggle="dropdown">
                Find Buddy
              </a>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="/buddy/matches"><i class="fa-solid fa-heart me-2"></i>Find
                    Matches</a></li>
                <li><a class="dropdown-item" href="/buddy/listings"><i
                      class="fa-solid fa-map-marked-alt me-2"></i>Listings</a></li>
                <li><a class="dropdown-item" href="/buddy/map"><i class="fa-solid fa-map me-2"></i>Interactive Map</a>
                </li>
                <li><a class="dropdown-item" href="/buddy/requests"><i
                      class="fa-solid fa-envelope me-2"></i>Requests</a></li>
                <li><a class="dropdown-item" href="/buddy/inbox"><i class="fa-solid fa-inbox me-2"></i>Inbox</a></li>
              </ul>
            </div>
            <% } else { %>
              <!-- Logged-out: Disabled button with tooltip -->
              <div class="nav-item ms-0 ms-md-2 position-relative text-center text-md-start">
                <button class="btn-find-buddy disabled-feature d-block d-md-inline-block" data-auth-required="true"
                  type="button">
                  Find Buddy
                </button>
                <div class="auth-tooltip">You need to be logged in to use this feature</div>
              </div>
              <% } %>
        </div>

        <!-- Right Side (Auth Buttons) -->
        <div class="navbar-nav ms-auto align-items-center d-flex flex-column flex-md-row gap-3 gap-md-0 mt-3 mt-md-0">
          <% if (!currUser) { %>
            <a class="btn btn-login-custom mb-2 mb-md-0 text-center" href="/login">Login</a>
            <a class="btn btn-signup-custom text-center" href="/signup">Sign Up</a>
            <% } else { %>
              <div class="nav-item dropdown text-center text-md-start">
                <a class="nav-link dropdown-toggle user-profile-box justify-content-center justify-content-md-start"
                  href="#" role="button" data-bs-toggle="dropdown">
                  <i class="fa-solid fa-user-circle me-1"></i>
                  <%= currUser.username %>
                    <% if (currUser.role==='admin' ) { %>
                      <span class="badge bg-warning text-dark ms-1" style="font-size: 0.7rem;">Admin</span>
                      <% } %>
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                  <% if (currUser.role==='admin' ) { %>
                    <li>
                      <h6 class="dropdown-header">Admin Panel</h6>
                    </li>
                    <li><a class="dropdown-item" href="/admin"><i class="fa-solid fa-gauge me-2"></i>Dashboard</a></li>
                    <li><a class="dropdown-item" href="/coupons"><i class="fa-solid fa-ticket-alt me-2"></i>Coupons</a>
                    </li>
                    <li>
                      <hr class="dropdown-divider">
                    </li>
                    <li><a class="dropdown-item" href="/analytics/dashboard"><i
                          class="fa-solid fa-chart-bar me-2"></i>Analytics</a></li>
                    <% } else { %>
                      <li><a class="dropdown-item" href="/analytics/dashboard"><i
                            class="fa-solid fa-chart-bar me-2"></i>Analytics</a></li>
                      <% } %>
                        <li>
                          <hr class="dropdown-divider">
                        </li>
                        <li><a class="dropdown-item" href="/bookings"><i class="fa-solid fa-calendar-check me-2"></i>My
                            Bookings</a></li>
                        <li>
                          <hr class="dropdown-divider">
                        </li>
                        <li><a class="dropdown-item" href="/logout"><i
                              class="fa-solid fa-sign-out-alt me-2"></i>Logout</a></li>
                </ul>
              </div>
              <% } %>
        </div>
      </div>
    </div>
  </nav>